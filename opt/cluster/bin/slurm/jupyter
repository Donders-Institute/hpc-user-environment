#!/bin/bash
#
# 20170217 edwger: initial script to redirect jupyter if not notebook arg
#

# determin jupyer subcommand from script name or first argument
subcommand=$(basename $0 | sed 's/^jupyter-//g')

if [ "$subcommand" == "$(basename $0)" ]; then
   subcommand=$1
fi

[[ "$subcommand" != "notebook" && "$subcommand" != "lab" ]] && echo "subcommand not supported: $subcommand" >&2 && exit 1

# load helper functions
source $CLUSTER_UTIL_ROOT/share/cluster-lib.sh

ensure_environment_module

SELECTION=$(yad \
    --center \
    --width=300 \
    --ontop \
    --buttons-layout=center \
    --title="Jupyter $subcommand" \
    --text="Select desired Anaconda version:" \
    --text-align=center \
    --form \
    --separator=" " \
    --item-separator="\n" \
    --field="Anaconda Version:":CB \
    "$(module_avail_versions 'anaconda3')")
ret=$?
if [[ $ret -eq 1 ]] || [[ $ret -eq 252 ]]
then
    echo "Command Cancelled"; exit 0
fi

IFS=' ' read -r -a CHOICES <<< $SELECTION
VERSION=$(echo ${CHOICES[0]})

module unload anaconda anaconda2 anaconda3 > /dev/null 2>&1

echo "Loading module anaconda3/$VERSION ..."
module load anaconda3/$VERSION

if [ -z $SLURM_JOBID ]; then
    run_guiapp Jupyter-$subcommand "jupyter $subcommand --ip=\$(hostname -f) --notebook-dir=\$SLURM_SUBMIT_DIR" guimenu
else
    echo "Starting jupyter $subcommand gui App..."
    jupyter $subcommand --ip=$(hostname -f) --notebook-dir=.
fi