#!/bin/bash
#
# shell script to start FSL as a slurm job
#
# 20170626 edwger: do NOT reload module is one is already loaded
# 20170413 edwger: check for eventually loaded module
# 20170217 edwger: initial torque wrapperscript
#

# load helper functions
source $CLUSTER_UTIL_ROOT/share/cluster-lib.sh

mydir=`get_script_dir $0`

ensure_environment_module

SELECTION=$(yad \
    --center \
    --width=300 \
    --ontop \
    --buttons-layout=center \
    --title="FSL" \
    --text="Select desired FSL version:" \
    --text-align=center \
    --form \
    --separator=" " \
    --item-separator="\n" \
    --field="FSL Version:":CB \
    "$(module_avail_versions 'fsl')")
ret=$?

if [[ $ret -eq 1 ]] || [[ $ret -eq 252 ]]
then
    echo "Command Cancelled"; exit 0
fi

IFS=' ' read -r -a CHOICES <<< $SELECTION
FSL_SELECTION=$(echo ${CHOICES[0]})

module unload fsl > /dev/null 2>&1
echo "Loading module fsl/$FSL_SELECTION ..."
module load fsl/$FSL_SELECTION

if [ -z $SLURM_JOBID ]; then
    run_guiapp FSL $FSLDIR/bin/fsl guimenu
else
    echo "Starting fsl gui App..."
    $FSLDIR/bin/fsl &
fi
