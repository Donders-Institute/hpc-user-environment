#!/bin/bash
#
# shell script to start pycharm as a slurm job or OOD binary

function pycharm_executable() {
    [[ "$PYCHARM_BIN" != "" && -x "$PYCHARM_BIN" ]] &&
        echo "$PYCHARM_BIN" ||
        which pycharm 
}

# load helper functions
source $CLUSTER_UTIL_ROOT/share/cluster-lib.sh

ensure_environment_module

info=$(cat << EOF
Please select a desired PyCharm version.

The pre-selected version is either the latest version (i.e. system default)\nor the version loaded manually before this launcher is started.
EOF
)

SELECTION=$(yad \
    --center \
    --width=300 \
    --ontop \
    --title="PyCharm launcher" \
    --text="${info}" \
    --text-align=center \
    --image=/opt/cluster/system-files/icons/pycharm-48.png \
    --form \
    --separator=" " \
    --item-separator="\n" \
    --field="version":CB \
    "$(module_avail_versions 'pycharm')")
ret=$?

if [[ $ret -eq 1 ]] || [[ $ret -eq 252 ]]
then
    echo "Command Cancelled"; exit 0
fi

IFS=' ' read -r -a CHOICES <<< $SELECTION
PYCHARM_SELECTION=$(echo ${CHOICES[0]})

module unload pycharm > /dev/null 2>&1
echo "Loading module pycharm/$PYCHARM_SELECTION ..."
module load pycharm/$PYCHARM_SELECTION

if [ -z $SLURM_JOBID ]; then
    # start the pycharm via a job
    MEM=6 run_guiapp PyCharm "$(pycharm_executable)" guimenu
else
    echo "Starting PyCharm gui App..."
    "$(pycharm_executable)" 2>/dev/null &
fi

