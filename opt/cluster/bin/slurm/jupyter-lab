#!/bin/bash
#
# shell script to start graphical Anaconda/jupyter lab webserver
# as a torque job
#
# 20210122 honlee: get list of available modules from /opt/_modules/anaconda? 
# 20170626 edwger: do NOT reload module if one is already loaded
# 20170217 edwger: initial torque wrapperscript
#

# load helper functions
source $CLUSTER_UTIL_ROOT/share/cluster-lib.sh

ensure_environment_module

SELECTION=$(yad \
    --center \
    --width=300 \
    --ontop \
    --buttons-layout=center \
    --title="Jupyter-Notebook" \
    --text="Select desired Anaconda version:" \
    --text-align=center \
    --form \
    --separator=" " \
    --item-separator="\n" \
    --field="Anaconda Version:":CB \
    "$(module_avail_versions 'anaconda3')")
ret=$?
if [[ $ret -eq 1 ]] || [[ $ret -eq 252 ]]
then
    echo "Command Cancelled"; exit 0
fi

IFS=' ' read -r -a CHOICES <<< $SELECTION
NOTEBOOK_SELECTION=$(echo ${CHOICES[0]})

module unload anaconda anaconda2 anaconda3 > /dev/null 2>&1

echo "Loading module anaconda3/$NOTEBOOK_SELECTION ..."
module load anaconda3/$NOTEBOOK_SELECTION

if [ -z $SLURM_JOBID ]; then
    run_guiapp Jupyter-Lab 'jupyter lab --ip=$(hostname -f) --notebook-dir=$SLURM_SUBMIT_DIR' guimenu
else
    echo "Starting jupyter lab gui App..."
    jupyter lab --ip=$(hostname -f) --notebook-dir=.
fi

