#!/bin/bash
#
# Rewrite of yad progress bar menu with Slurm (Torque successor) JOB info
# for walltime and memory
#
# 20230817: edwger - initial start
#

function display_usage() {
   # show how this script should be run
   echo "This script can only run within an interactive slurm job and" 
   echo "is usually automatically started when submitting an interactive"
   echo "slurm job."
}

function megabytes {
   # convert bytes to MB
   if [ -n "$1" ]; then
      echo "$1/(1024*1024)" | bc
   else
      echo 0
   fi
}

function seconds {
    # convert ##-##:##:## (days-hours:minutes:seconds) to seconds
    echo $1 | sed 's/:\|-/ /g;' | awk '{print $4" "$3" "$2" "$1}' | awk '{print $1+$2*60+$3*3600+$4*86400}'
}

function job_walltime_info {
    info=( $(squeue -j $SLURM_JOBID -h -o "%l %M") )
    seconds ${info[0]}
    seconds ${info[1]}
}

function job_memory_info {
    cgget -r memory.memsw.$1 \
        /slurm/uid_$SLURM_JOB_UID/job_$SLURM_JOBID \
    | sed '1d;$d' \
    | awk -F" " '{ print $2 }'
}

# Main progressbars function
function info {
   [ ! -e /usr/bin/yad ] && echo "YAD not found: /usr/bin/yad" >&2 && exit

   requested_memory=$(job_memory_info limit_in_bytes)
  
   walltime_info=( $(job_walltime_info) )
   requested_walltime=${walltime_info[0]}
   elapsed_walltime=${walltime_info[1]}

   # YAD progress bars loop start here
   while [ $elapsed_walltime -lt $requested_walltime ]; do

      used_memory=$(job_memory_info usage_in_bytes)
      max_used_memory=$(job_memory_info max_usage_in_bytes)

      walltime_info=( $(job_walltime_info) )
      requested_walltime=${walltime_info[0]}
      elapsed_walltime=${walltime_info[1]}

      # Calculate percent
      WALLPERCENT=$((100*elapsed_walltime/requested_walltime))
      MEMPERCENT=$((100*used_memory/requested_memory))
      MAXMEMPERCENT=$((100*max_used_memory/requested_memory))
      
      PRINTWALL=$(squeue --jobs $SLURM_JOBID -o "%L" | sed '1d')
      PRINTMEM=`megabytes $used_memory`
      PRINTMEMINITIAL=`megabytes $requested_memory`
      PRINTMAXMEM=`megabytes $max_used_memory`

      printf "1:$WALLPERCENT\n2:$MEMPERCENT\n3:$MAXMEMPERCENT\n"
      printf "1:#Time remaining $PRINTWALL\n2:#Memory usage: $PRINTMEM MB of requested $PRINTMEMINITIAL MB\n3:#Max used memory: $PRINTMAXMEM MB of requested $PRINTMEMINITIAL MB\n"
      sleep 1
   done | dbus-run-session -- /usr/bin/yad --geometry=470x140-1+0 \
         --no-focus \
         --title "JOBinfo for ${JOB%%.*}" \
         --text "Exec node:\t\t<b>$SLURM_NODELIST</b>" \
         --multi-progress \
         --progress \
         --percentage=0 \
         --bar="Elapsed Walltime":NORM \
         --bar="Memory usage    ":NORM \
         --bar="Max memory usage":NORM \
         --button="Terminate this Slurm JOBID: ${SLURM_JOBID}":"scancel ${SLURM_JOBID}" \
         --button='Request jobtime extension:/bin/bash -c "$CLUSTER_UTIL_ROOT/bin/slurm/yadextend-jobtime"' \
         --buttons-layout=center \
         --auto-close \
         --auto-kill &
   echo "Job info started..."
}

###############################
### M A I N   P R O G R A M ###
###############################

# ENVIRONMENT SETTING
export NO_AT_BRIDGE=1

# Check where and how we are running
if [ -z "$SLURM_JOBID" ] ; then 
   display_usage
   exit 1
fi

# Check display variable
if [ -z "$DISPLAY" ] ; then 
   echo "invalid DISPLAY: $DISPLAY" >&2
   exit 1
fi

# setup for dependency-free, bare-minimal GTK environment
export GIO_USE_VFS=local
export DCONF_PROFILE=/dev/null

# set XDG_RUNTIME_DIR to job's scratch dir 
export XDG_RUNTIME_DIR=$TMPDIR

# Check for JOBNAME or JOBID
JOB=${SLURM_JOBID}
if [ "${SLURM_JOB_NAME}" != "" ]; then
   JOB=${SLURM_JOB_NAME}
fi

info
