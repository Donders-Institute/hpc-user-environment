######################################################################

#
# All we need is the sum of current walltime and extension hours
#
# Walltime (TimeLimit) is recalculated
#

# Condition validations during extension request

HRS=$(echo ${EXTENSION})

# Check if HRS is empty or less than 1
if [[ -z "$HRS" ]] || (( $HRS < 1 )) ; then
   # Input is empty or less than 1.
      /bin/yad --title "Job time extension denied" \
            --width=400 \
            --height=120 \
            --on-top \
            --center \
            --buttons-layout=center \
            --text-align=center \
            --fontname="Sans Bold 20" \
            --text="
Job time extension input is empty or less than 1.

Please enter job time extension in hours
with a maximum time extension of 72 hours.
" \
            --text-align=center \
            --button=yad-ok
   exit 1
fi

# Check if HRS is lower or equal than 72 (max walltime extension)
if [[ "$HRS" -gt 72 ]] ; then
   # Maximum job extension is 72 hours.
   /bin/yad --title "Job time extension denied" \
            --width=400 \
            --height=120 \
            --on-top \
            --center \
            --buttons-layout=center \
            --text-align=center \
            --fontname="Sans Bold 20" \
            --text="
Time extension for your job
with jobID ${SLURM_JOBID} is <b>denied.</b>

Maximum time Extension is 72 hours.
" \
            --text-align=center \
            --button=yad-ok
   exit 1
fi

# All conditions are met
#Generation variables for email generation

extension=$HRS
#echo extension=$HRS
extension_in_seconds=$(echo $extension*3600 | bc)
#echo extension_in_seconds=$extension_in_seconds
current_time_in_seconds=$(seconds $(squeue -j $SLURM_JOBID -h -o "%l"))
#echo current_time_in_seconds=$current_walltime_in_seconds

# Sum of the above:
new_walltime_in_seconds=$(echo $current_time_in_seconds+$extension_in_seconds | bc)
#echo new_walltime_in_seconds=$new_walltime_in_seconds

wt_secs=$new_walltime_in_seconds
cur_secs=$current_time_in_seconds
ext_secs=$extension_in_seconds

# In Slurm notation:
if [[ $wt_secs -ge 86400 ]]; then
   nw_wt=`printf '%d-%d:%d:%d\n' $((wt_secs/86400)) $((wt_secs%86400/3600)) $((wt_secs%3600/60)) $((wt_secs%60))`
else
   nw_wt=`printf '%d:%d:%d\n' $((wt_secs%86400/3600)) $((wt_secs%3600/60)) $((wt_secs%60))`
fi

if [[ $cur_secs -ge 86400 ]]; then
   cur_wt=`printf '%d-%d:%d:%d\n' $((cur_secs/86400)) $((cur_secs%86400/3600)) $((cur_secs%3600/60)) $((cur_secs%60))`
else
   cur_wt=`printf '%d:%d:%d\n' $((cur_secs%86400/3600)) $((cur_secs%3600/60)) $((cur_secs%60))`
fi

if [[ $ext_secs -ge 86400 ]]; then
   wt_ext=`printf '%d-%d:%d:%d\n' $((ext_secs/86400)) $((ext_secs%86400/3600)) $((ext_secs%3600/60)) $((ext_secs%60))`
else
   wt_ext=`printf '%d:%d:%d\n' $((ext_secs%86400/3600)) $((ext_secs%3600/60)) $((ext_secs%60))`
fi

# Sending email
mailing $extension
