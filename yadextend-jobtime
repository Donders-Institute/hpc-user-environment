#then
#   export remaining_walltime_secs=$(echo $remaining_walltime | awk -F: '{ print ($1 * 3600) + ($2 * 60) + $3 }')
#else
#   export remaining_walltime_secs=$(echo $remaining_walltime | awk -F: '{ print ($1 * 60) + $2 }')
#fi
#echo $remaining_walltime_secs
if [[ "$remaining_walltime" -gt 14400 ]] ; then
   # Remaining walltime must be less then 4 hours.
   /bin/yad --title "Job time extension denied" \
            --width=400 \
            --height=120 \
            --on-top \
            --center \
            --buttons-layout=center \
            --text-align=center \
            --fontname="Sans Bold 20" \
            --text="
Time extension for your job
with jobID ${SLURM_JOBID} is <b>denied.</b>

Jobtime remaining must be less than 4 hours.
" \
            --text-align=center \
            --button=yad-ok
   exit 1
fi

# Below yad dialog asks for walltime extension
EXTENSION=$(yad \
            --center \
            --ontop \
            --buttons-layout=center \
            --auto-kill \
            --auto-close \
            --title="Job time Extension" \
            --text="
An email to DCCN Helpdesk will be generated.

DCCN Helpdesk is only available
during office hours on weekdays.

Walltime can only be extended for your running jobs.
" \
            --text-align=center \
            --form \
            --separator=" " \
            --field="Enter walltime extension in hours:" )

ret=$?

if [[ $ret -eq 1 ]] || [[ $ret -eq 252 ]]
then
   echo "Command Cancelled..."
   echo
   exit 1
fi

