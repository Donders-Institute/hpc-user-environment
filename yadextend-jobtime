#!/bin/bash
#
# This script generates an email to helpdesk with a walltime extension request
# The request has to meet some conditions which will be validated:
# 1. request is only valid between 9am and 16pm (office hours helpdesk)
# 2. the remaining walltime must be less than 4 hours and will be
#    checked in this script.
# 3. max walltime extension is 72 hours
# 

function seconds {
    # convert ##-##:##:## (days-hours:minutes:seconds) to seconds
    echo $1 | sed 's/:\|-/ /g;' | awk '{print $4" "$3" "$2" "$1}' | awk '{print $1+$2*60+$3*3600+$4*86400}'
}

function mailing() {
   # Here the mail is generated and send to Helpdesk
   REQ=$1
   username=$(/usr/bin/getent passwd $USER | awk -F: '{ print $5 }')
   #echo Mailing $username
   (
   echo Dear Helpdesk,
   echo 
   echo "Request for walltime extension on Slurm HPC cluster:"
   echo "JobID: $SLURM_JOBID"
   echo "Walltime extension: $REQ hours"
   echo
   echo "Run as root on the slurm server:"
   echo "scontrol update jobid=$SLURM_JOBID TimeLimit=$nw_wt"
   echo
   echo "Current walltime is:    $cur_wt"
   echo "Walltime to add is :    $REQ hours ($wt_ext)"
   echo "New walltime should be: $nw_wt"
   echo
   echo "Thanks in advance."
   echo
   echo "Yours,"
   echo "$username."
   # sending email
   )  | mail -s "Request walltime extension for ${username}" E.Gerrits@donders.ru.nl

   /bin/yad --title "Sending email to helpdesk" \
            --width=400 \
            --height=120 \
            --on-top \
            --center \
            --buttons-layout=center \
            --text-align=center \
            --fontname="Sans Bold 20" \
            --text="
Job time extension request email is
sent to helpdesk@donders.ru.nl.

Keep checking you JOBinfo for HPC_Desktop
information dialog for jobID ${SLURM_JOBID}
" \
            --text-align=center \
            --button=yad-ok
   exit 0
}

# Checks before extension dialog

# Check helpdesk office hours
ohrsmin=9
ohrsmax=16
nowhrs=$(date +%H)

if [[ $nowhrs -lt $ohrsmin ]] || [[ $nowhrs -gt $ohrsmax ]] ; then
   # Time extension request is outside helpdesk office hours.
   /bin/yad --title "Job time extension denied" \
            --width=400 \
            --height=120 \
            --on-top \
            --center \
            --buttons-layout=center \
            --text-align=center \
            --fontname="Sans Bold 20" \
            --text="
Time extension for your job
with jobID ${SLURM_JOBID}\nis <b>denied.</b>

Extension request only valid between 9am and 16pm.
" \
            --text-align=center \
            --button=yad-ok
   exit 1
fi
	
# Check if Remaining Walltime is less than 4 hours
remaining_walltime=$(seconds $(squeue -h -j $SLURM_JOBID -o "%L"))
# convert to seconds
